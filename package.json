{
  "name": "agentic-qa-framework",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspace @agentic-qa/desktop",
